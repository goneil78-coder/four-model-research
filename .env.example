# Keys are read from the first file found:
#   $FOUR_MODEL_ENV, ./.env, ~/.four-model-research.env, ~/.claude/.env
# Values are parsed as data, never executed — but quote anything containing
# | & ; $ ( ) anyway, for the sake of other tools that do source this file.

XAI_API_KEY="xai-..."          # grok lane — console.x.ai
GEMINI_API_KEY="AIza..."       # gemini lane — aistudio.google.com/apikey

# The openai lane uses the codex CLI's own auth. Run `codex login` to use a
# ChatGPT subscription (no API key). OPENAI_API_KEY is only needed if you
# prefer to bill the API instead.
